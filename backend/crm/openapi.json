{
  "openapi": "3.0.3",
  "info": {
    "title": "Mary Detalles CRM",
    "version": "1.0.0",
    "description": "API de Semana 4. Las rutas privadas se autorizan con el token access obtenido al iniciar sesión."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/auth/token/": {
      "post": {
        "tags": [
          "Acceso"
        ],
        "summary": "Iniciar sesión",
        "operationId": "login",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credenciales"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token JWT y rol.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sesion"
                }
              }
            }
          },
          "400": {
            "description": "Error de validación por campo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Validacion"
                }
              }
            }
          },
          "401": {
            "description": "Credenciales incorrectas o JWT ausente o inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "La cuenta no tiene un rol en el CRM.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/leads/": {
      "get": {
        "tags": [
          "Leads"
        ],
        "summary": "Listar y buscar leads",
        "operationId": "listarLeads",
        "parameters": [
          {
            "name": "estado",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "nuevo",
                "contactado",
                "cotizado",
                "ganado",
                "perdido"
              ]
            }
          },
          {
            "name": "fuente",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "whatsapp",
                "instagram",
                "facebook",
                "web",
                "presencial",
                "referido",
                "otro"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Listado de leads.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Lead"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Error de validación por campo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Validacion"
                }
              }
            }
          },
          "401": {
            "description": "Credenciales incorrectas o JWT ausente o inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Leads"
        ],
        "summary": "Registrar un lead",
        "operationId": "registrarLead",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeadEntrada"
              },
              "example": {
                "nombre": "Ana Ejemplo",
                "correo": "ana@example.test",
                "telefono": "80000015",
                "interes": "Taza personalizada",
                "fuente": "web"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Lead registrado en estado nuevo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Lead"
                }
              }
            }
          },
          "400": {
            "description": "Error de validación por campo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Validacion"
                }
              }
            }
          },
          "401": {
            "description": "Credenciales incorrectas o JWT ausente o inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/leads/{pk}/": {
      "parameters": [
        {
          "name": "pk",
          "in": "path",
          "required": true,
          "description": "Identificador del lead.",
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "get": {
        "tags": [
          "Leads"
        ],
        "summary": "Consultar un lead",
        "operationId": "consultarLead",
        "responses": {
          "200": {
            "description": "Datos del lead.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Lead"
                }
              }
            }
          },
          "401": {
            "description": "Credenciales incorrectas o JWT ausente o inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "El lead no existe.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Leads"
        ],
        "summary": "Editar un lead",
        "operationId": "editarLead",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeadEntrada"
              },
              "example": {
                "nombre": "Ana Ejemplo",
                "correo": "ana@example.test",
                "telefono": "80000015",
                "interes": "Taza personalizada",
                "fuente": "web"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lead actualizado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Lead"
                }
              }
            }
          },
          "400": {
            "description": "Error de validación por campo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Validacion"
                }
              }
            }
          },
          "401": {
            "description": "Credenciales incorrectas o JWT ausente o inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "El lead no existe.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/health/": {
      "get": {
        "tags": [
          "Servicio"
        ],
        "summary": "Verificar que la API responde",
        "operationId": "health",
        "security": [],
        "responses": {
          "200": {
            "description": "Servicio disponible.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Credenciales": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 150
          },
          "password": {
            "type": "string",
            "format": "password",
            "maxLength": 128,
            "writeOnly": true
          }
        }
      },
      "Sesion": {
        "type": "object",
        "required": [
          "access",
          "usuario"
        ],
        "properties": {
          "access": {
            "type": "string"
          },
          "usuario": {
            "type": "object",
            "required": [
              "username",
              "rol"
            ],
            "properties": {
              "username": {
                "type": "string"
              },
              "rol": {
                "type": "string",
                "enum": [
                  "vendedor",
                  "administrador"
                ]
              }
            }
          }
        }
      },
      "LeadEntrada": {
        "type": "object",
        "required": [
          "nombre",
          "correo",
          "telefono",
          "interes",
          "fuente"
        ],
        "properties": {
          "nombre": {
            "type": "string",
            "maxLength": 120
          },
          "correo": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "telefono": {
            "type": "string",
            "maxLength": 25
          },
          "interes": {
            "type": "string",
            "maxLength": 200
          },
          "mensaje": {
            "type": "string",
            "maxLength": 2000
          },
          "fuente": {
            "type": "string",
            "enum": [
              "whatsapp",
              "instagram",
              "facebook",
              "web",
              "presencial",
              "referido",
              "otro"
            ]
          },
          "asignado_a": {
            "type": "string",
            "nullable": true,
            "description": "Nombre de un usuario activo del grupo Vendedor."
          }
        }
      },
      "Lead": {
        "type": "object",
        "required": [
          "nombre",
          "correo",
          "telefono",
          "interes",
          "fuente",
          "id",
          "estado",
          "creado_en",
          "actualizado_en"
        ],
        "properties": {
          "nombre": {
            "type": "string",
            "maxLength": 120
          },
          "correo": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "telefono": {
            "type": "string",
            "maxLength": 25
          },
          "interes": {
            "type": "string",
            "maxLength": 200
          },
          "mensaje": {
            "type": "string",
            "maxLength": 2000
          },
          "fuente": {
            "type": "string",
            "enum": [
              "whatsapp",
              "instagram",
              "facebook",
              "web",
              "presencial",
              "referido",
              "otro"
            ]
          },
          "asignado_a": {
            "type": "string",
            "nullable": true,
            "description": "Nombre de un usuario activo del grupo Vendedor."
          },
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "estado": {
            "type": "string",
            "enum": [
              "nuevo",
              "contactado",
              "cotizado",
              "ganado",
              "perdido"
            ],
            "readOnly": true
          },
          "creado_en": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "actualizado_en": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string"
          }
        }
      },
      "Validacion": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "example": {
          "correo": [
            "Este campo es requerido."
          ]
        }
      }
    }
  }
}
